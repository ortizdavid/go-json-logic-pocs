[
  {
    "rule": {
      "if": [
        { "==": [ { "var": "order.customerType" }, "PF" ] },
        { "min": [ { "var": "order.discountPercent" }, 10 ] },
        { "==": [ { "var": "order.customerType" }, "PJ" ] },
        { "min": [ { "var": "order.discountPercent" }, 20 ] },
        { "var": "order.discountPercent" }
      ]
    },
    "field": "discountPercent"
  }
]
