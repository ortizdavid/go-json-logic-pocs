{
  "id": "discount_by_customer_type",
  "type": "VALIDATION",
  "errorMessage": "Desconto acima do permitido para o tipo de cliente",
  "logic": {
    "if": [
      { "==": [ { "var": "customerType" }, "PF" ] },
      { "<=": [ { "var": "discountPercent" }, 10 ] },
      { "<=": [ { "var": "discountPercent" }, 20 ] }
    ]
  }
}
